<?xml version="1.0" encoding="utf-8" ?>
<manifest>
  <control namespace="AlphaHouse" constructor="MarSheet" version="0.1.2"
           display-name-key="MAR Sheet"
           description-key="Paper-style Medication Administration Record. Each dose and reconciliation line is saved as its own record against the MAR Sheet."
           control-type="virtual">
    <external-service-usage enabled="false">
    </external-service-usage>
    <!-- Anchor binding only: put the control on the MAR Sheet main form bound to cp_name.
         The control reads the record id from the form and loads everything through the Web API. -->
    <property name="anchor" display-name-key="Anchor field" description-key="Bind to MAR Sheet Name (cp_name)."
              of-type="SingleLine.Text" usage="bound" required="true" />
    <resources>
      <code path="index.ts" order="1"/>
      <css path="css/MarSheet.css" order="1" />
      <platform-library name="React" version="16.14.0" />
    </resources>
    <feature-usage>
      <uses-feature name="WebAPI" required="true" />
    </feature-usage>
  </control>
</manifest>
